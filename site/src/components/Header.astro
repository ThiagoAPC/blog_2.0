---
import { url } from '../utils/url';
---

<header
  class="sticky top-0 z-40 border-b border-wire dark:border-void bg-cream/95 dark:bg-night/95 backdrop-blur-sm"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-14 gap-4">

      <!-- Brand -->
      <a
        href={url('')}
        class="flex items-center gap-2 font-bold text-sm text-ink dark:text-snow hover:text-rust dark:hover:text-rust transition-colors shrink-0"
      >
        <span class="text-rust text-base">🌙</span>
        <span class="hidden sm:inline whitespace-nowrap">Late Night Data Thoughts</span>
        <span class="sm:hidden font-mono text-xs tracking-widest">LNDT</span>
      </a>

      <!-- Nav (desktop) -->
      <nav class="hidden md:flex items-center gap-5 text-sm font-medium text-muted dark:text-snow/60">
        <a
          href={url('sobre')}
          class="hover:text-rust dark:hover:text-rust transition-colors"
        >Sobre</a>
        <a
          href="https://github.com/ThiagoAPC"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-rust dark:hover:text-rust transition-colors"
        >GitHub ↗</a>
        <a
          href={url('rss.xml')}
          class="hover:text-rust dark:hover:text-rust transition-colors"
        >RSS</a>
      </nav>

      <!-- Controls -->
      <div class="flex items-center gap-2 shrink-0">

        <!-- Search -->
        <button
          id="search-trigger"
          aria-label="Buscar artigos (Ctrl+K)"
          class="hidden sm:flex items-center gap-1.5 px-2.5 py-1 text-xs text-muted dark:text-snow/50 border border-wire dark:border-void rounded-md hover:border-rust hover:text-rust dark:hover:border-rust dark:hover:text-rust transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
          <span>Buscar</span>
          <kbd class="text-[10px] px-1 py-0.5 bg-wire dark:bg-void rounded font-sans">⌘K</kbd>
        </button>

        <!-- Search icon only on mobile -->
        <button
          id="search-trigger-mobile"
          aria-label="Buscar"
          class="sm:hidden p-1.5 text-muted dark:text-snow/50 border border-wire dark:border-void rounded-md hover:border-rust hover:text-rust transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
          </svg>
        </button>

        <!-- Language toggle -->
        <button
          id="lang-toggle"
          aria-label="Trocar idioma"
          title="Trocar idioma (em breve)"
          class="text-[11px] font-semibold px-2 py-1 rounded border border-wire dark:border-void text-muted dark:text-snow/50 hover:border-rust hover:text-rust dark:hover:border-rust dark:hover:text-rust transition-colors tracking-wider"
        >
          PT
        </button>

        <!-- Dark mode toggle -->
        <button
          id="theme-toggle"
          aria-label="Alternar modo claro/escuro"
          class="p-1.5 rounded border border-wire dark:border-void text-muted dark:text-snow/50 hover:border-rust hover:text-rust dark:hover:border-rust dark:hover:text-rust transition-colors"
        >
          <!-- Sun: visible in dark mode -->
          <svg
            id="icon-sun"
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="hidden dark:block"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
          </svg>
          <!-- Moon: visible in light mode -->
          <svg
            id="icon-moon"
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="block dark:hidden"
            aria-hidden="true"
          >
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  // ── Dark mode toggle ──────────────────────────────────────────────────────
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // ── Search modal opener ───────────────────────────────────────────────────
  function openSearch() {
    document.getElementById('search-modal')?.classList.remove('hidden');
    setTimeout(() => {
      (document.querySelector('#pagefind-search input') as HTMLInputElement)?.focus();
    }, 60);
  }

  document.getElementById('search-trigger')?.addEventListener('click', openSearch);
  document.getElementById('search-trigger-mobile')?.addEventListener('click', openSearch);

  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
  });
</script>
