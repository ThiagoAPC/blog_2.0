---
interface Props {
  type?: 'info' | 'warning' | 'tip' | 'note';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const config = {
  info:    { icon: 'ℹ️',  label: 'Info',    classes: 'border-blue-400  bg-blue-50   dark:bg-blue-950/30   text-blue-900  dark:text-blue-100'  },
  warning: { icon: '⚠️',  label: 'Atenção', classes: 'border-amber-400 bg-amber-50  dark:bg-amber-950/30  text-amber-900 dark:text-amber-100' },
  tip:     { icon: '💡',  label: 'Dica',    classes: 'border-green-400 bg-green-50  dark:bg-green-950/30  text-green-900 dark:text-green-100' },
  note:    { icon: '📝',  label: 'Nota',    classes: 'border-slate-400 bg-slate-50  dark:bg-slate-800/50  text-slate-900 dark:text-slate-100' },
};

const { icon, label, classes } = config[type];
---

<aside class={`my-6 border-l-4 rounded-r-lg px-4 py-3 ${classes}`}>
  <p class="font-semibold text-sm mb-1 flex items-center gap-1.5">
    <span aria-hidden="true">{icon}</span>
    {title ?? label}
  </p>
  <div class="text-sm [&>p]:mb-0 [&>p:last-child]:mb-0">
    <slot />
  </div>
</aside>
